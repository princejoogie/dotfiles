{
  "mcpServers": {
    "grep-app": {
      "type": "http",
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "http",
      "url": "https://mcp.context7.com/mcp"
    },
    "cua-driver": {
      "type": "stdio",
      "command": "cua-driver",
      "args": ["mcp"],
      "clients": ["opencode"]
    },
    "otel-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": ["opentelemetry-mcp"],
      "env": {
        "BACKEND_TYPE": "jaeger",
        "BACKEND_URL": "http://localhost:16686"
      }
    }
  }
}
