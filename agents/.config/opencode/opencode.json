{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      { "action": "provider.use", "resource": "openai", "effect": "allow" }
    ]
  },
  "permission": "allow",
  "mcp": {
    "grep-app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "shadcn": {
      "type": "local",
      "command": ["npx", "--yes", "shadcn@latest", "mcp"],
      "enabled": true
    },
    "argent": {
      "type": "local",
      "command": ["argent", "mcp"],
      "enabled": true
    },
    "cua-driver": {
      "type": "local",
      "command": ["cua-driver", "mcp"],
      "enabled": true
    },
    "otel-mcp": {
      "type": "local",
      "command": ["uvx", "opentelemetry-mcp"],
      "enabled": true,
      "environment": {
        "BACKEND_TYPE": "jaeger",
        "BACKEND_URL": "http://localhost:16686"
      }
    }
  }
}
