{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "providers": {
    "cliproxy-codex": {
      "name": "Codex via CLIProxyAPI",
      "canonical": "openai",
      "package": "@opencode/ai/providers/openai-compatible/responses",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{file:~/.config/opencode/secrets/cliproxyapi-key}"
      },
      "models": {
        "gpt-6.1-sol": {},
        "gpt-6-astra": {},
        "gpt-6-sol": {},
        "gpt-6-luna": {},
        "gpt-5.6-sol": {},
        "gpt-5.6-terra": {},
        "gpt-5.6-luna": {}
      }
    },
    "anthropic": {
      "name": "Claude via CLIProxyAPI",
      "settings": {
        "baseURL": "http://127.0.0.1:8317/v1",
        "apiKey": "{file:~/.config/opencode/secrets/cliproxyapi-key}"
      }
    }
  },
  "experimental": {
    "policies": [
      {
        "action": "provider.use",
        "resource": "*",
        "effect": "deny"
      },
      {
        "action": "provider.use",
        "resource": "openai",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "anthropic",
        "effect": "allow"
      },
      {
        "action": "provider.use",
        "resource": "cliproxy-codex",
        "effect": "allow"
      }
    ]
  },
  "permission": "allow",
  "mcp": {
    "grep-app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "cua-driver": {
      "type": "local",
      "command": [
        "cua-driver",
        "mcp"
      ],
      "enabled": true
    },
    "otel-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "opentelemetry-mcp"
      ],
      "enabled": true,
      "environment": {
        "BACKEND_TYPE": "jaeger",
        "BACKEND_URL": "http://localhost:16686"
      }
    }
  }
}
