{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "permission": "allow",
  "plugin": ["opencode-with-claude"],
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        },
        "gpt-5.6-sol-fast": {
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000
          }
        }
      }
    },
    "anthropic": {
      "options": {
        "baseURL": "http://127.0.0.1:3456",
        "apiKey": "dummy"
      }
    }
  },
  "agent": {
    "design": {
      "mode": "subagent",
      "description": "Designs elegant and intuitive user interfaces",
      "model": "xai/grok-4.6",
      "options": {}
    }
  },
  "mcp": {
    "grep_app": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "computer-use": {
      "type": "local",
      "command": ["cua-driver", "mcp"],
      "enabled": true
    },
    "otel-mcp": {
      "type": "local",
      "command": ["uvx", "opentelemetry-mcp"],
      "enabled": true,
      "environment": {
        "BACKEND_TYPE": "jaeger",
        "BACKEND_URL": "http://localhost:16686"
      }
    }
  },
  "websearch": {
    "provider": "random"
  }
}
