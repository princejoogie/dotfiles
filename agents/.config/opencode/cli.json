{
  "theme": {
    "name": "opencode-black"
  },
  "diffs": {
    "wrap": "none",
    "tree": true,
    "single": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "keybinds": {
    "session.tab.next": "<leader>j",
    "session.tab.previous": "<leader>k"
  },
  "tabs": {
    "enabled": false,
    "vertical": false,
    "scope": "global",
    "layout": "horizontal"
  },
  "attention": {
    "enabled": false,
    "volume": 0,
    "sound": false,
    "notifications": false
  },
  "terminal": {
    "title": true
  },
  "debug": {
    "devtools": false,
    "turn_tokens": false
  }
}
