{
  "$schema": "https://opencode.ai/theme.json",
  "base": {
    "categorical": [
      "purple",
      "orange",
      "green",
      "blue",
      "red"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "$hue.neutral.800",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "$hue.neutral.800",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "#e6b673"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "#000000",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#6c7380"
    },
    "scrollbar": {
      "base": "#6c7380"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "#f26d78",
        "context": "#acb6bf",
        "hunkHeader": "#acb6bf"
      },
      "background": {
        "added": "#20303b",
        "removed": "#37222c",
        "context": "$hue.neutral.700"
      },
      "highlight": {
        "added": "#aad94c",
        "removed": "#f07178"
      },
      "lineNumber": {
        "text": "#acb6bf",
        "background": {
          "added": "#1b2b34",
          "removed": "#2d1f26"
        }
      }
    },
    "syntax": {
      "comment": "#acb6bf",
      "keyword": "#ff8f40",
      "function": "#ffb454",
      "variable": "$hue.interactive.200",
      "string": "#aad94c",
      "number": "$hue.purple.200",
      "type": "#e6b673",
      "operator": "#f29668",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.purple.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.cyan.200",
      "code": "#aad94c",
      "blockQuote": "#e6b673",
      "emphasis": "#e6b673",
      "strong": "#ffb454",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.interactive.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  },
  "light": {
    "hue": {
      "gray": {
        "100": "#f6f1f1",
        "200": "#bfbdb6",
        "300": "#828d8b",
        "400": "#565b66",
